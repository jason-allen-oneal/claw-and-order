# Create an official Discord application. Never use an ordinary user's token.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Exact channel IDs only. Threads must be listed separately. No wildcard scope.
OBSERVED_CHANNEL_IDS=
# Commands work only here, and only for members with Manage Server permission.
MODERATOR_CHANNEL_ID=
DATABASE_URL=postgresql://claw:local-development-only@localhost:5432/claw

# New-message monitoring. OFF means /review gets no newly collected activity.
# No history backfill is implemented. New activity can be reviewed automatically.
# Configure scope and permissions before enabling. Values below are install defaults.
COLLECTION_ENABLED=false
# Test-only option: include ordinary bot-authored messages in observations.
# Webhook and system messages remain excluded.
CAPTURE_BOT_MESSAGES=false
# Separate switch for text-derived features. Raw bodies are not stored.
CONTENT_SIGNALS_ENABLED=false
# This is an operator acknowledgment, NOT Discord approval or a compliance guarantee.
POLICY_REVIEW_ACKNOWLEDGED=false
# Required for content signals: generate with `openssl rand -hex 32`.
# Changing this key breaks fingerprint comparisons with existing retained records.
FINGERPRINT_SECRET=
RETENTION_DAYS=7
MAX_REVIEW_MESSAGES=2000

# Blank defaults to ON when collection AND content signals are enabled.
# Set false for manual-review-only mode. Set true to require automatic operation.
AUTO_REVIEW_ENABLED=
AUTO_REVIEW_TICK_SECONDS=15
AUTO_REVIEW_INTERVAL_SECONDS=300
AUTO_REVIEW_BATCH_SIZE=10
# Heuristic threshold, NOT a probability; at least two families must qualify.
AUTO_CASE_THRESHOLD=60
# New cases need post-resolution evidence, not just expiry of this cooldown.
CASE_COOLDOWN_HOURS=24
